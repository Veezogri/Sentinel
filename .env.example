# Sentinel — local environment template.
# Copy to `.env` and adjust. `.env` is gitignored: never commit real credentials.
#
#   cp .env.example .env

# --- PostgreSQL -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel
DB_USER=sentinel
DB_PASSWORD=sentinel

# --- Kafka ------------------------------------------------------------------
# From the host. Containers on the sentinel network use kafka:29092 instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend ----------------------------------------------------------------
SERVER_PORT=8080
